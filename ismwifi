#!/usr/bin/env bash
# ==============================================================================
# ismwifi - Persistent auto-login daemon for IIT (ISM) Campus Wi-Fi
# ==============================================================================

set -uo pipefail

PORTAL="https://netaccess.iitism.ac.in:6082"
EXPECTED_SSID="ISM-Campus-Wi-Fi"

REFRESH_SECONDS=3600 # Re-authenticate every 60 minutes
CHECK_SECONDS=15     # Check Wi-Fi state every 15 seconds
RETRY_SECONDS=30     # Retry interval on login failure
PROBE_SECONDS=30     # Active internet health probe interval

SERVICE_NAME="ismwifi.service"
INSTALL_BIN="$HOME/.local/bin/ismwifi"
SYSTEMD_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
SYSTEMD_FILE="$SYSTEMD_DIR/$SERVICE_NAME"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ismwifi"
CREDENTIAL_FILE="$CONFIG_DIR/credentials"
COOKIE_FILE="$CONFIG_DIR/cookie"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"
}

check_dependencies() {
    local missing=()
    for cmd in curl ip systemctl nmcli; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            missing+=("$cmd")
        fi
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        echo -e "${RED}ERROR:${NC} Missing required command(s): ${BOLD}${missing[*]}${NC}" >&2
        echo "Please install them via your system package manager." >&2
        exit 1
    fi
}

is_internet_alive() {
    local code
    code=$(curl -sI -o /dev/null -w "%{http_code}" --connect-timeout 2 --max-time 3 "http://connectivitycheck.gstatic.com/generate_204" 2>/dev/null || echo "000")
    [[ "$code" == "204" ]]
}

# ==============================================================================
# Credentials Management
# ==============================================================================

has_credentials() {
    [[ -f "$CREDENTIAL_FILE" ]] && \
    [[ -n "$(sed -n '1p' "$CREDENTIAL_FILE" 2>/dev/null)" ]] && \
    [[ -n "$(sed -n '2p' "$CREDENTIAL_FILE" 2>/dev/null)" ]]
}

load_credentials() {
    if ! has_credentials; then
        echo -e "${RED}ERROR:${NC} Credentials not found. Run 'ismwifi' or 'ismwifi config' first." >&2
        exit 1
    fi
    USERNAME=$(sed -n '1p' "$CREDENTIAL_FILE")
    PASSWORD=$(sed -n '2p' "$CREDENTIAL_FILE")
}

prompt_credentials() {
    mkdir -p "$CONFIG_DIR"
    chmod 700 "$CONFIG_DIR"

    echo
    echo -e "${BOLD}${CYAN}============================================================${NC}"
    echo -e "${BOLD}          IIT (ISM) NetAccess Credentials Setup             ${NC}"
    echo -e "${BOLD}${CYAN}============================================================${NC}"
    echo "Saved locally in: $CREDENTIAL_FILE (chmod 600)"
    echo

    local tty="/dev/stdin"
    [[ ! -t 0 && -e /dev/tty ]] && tty="/dev/tty"

    local input_user input_pass

    while true; do
        read -r -p "Admission No / Username: " input_user < "$tty"
        input_user=$(echo "$input_user" | xargs)
        [[ -n "$input_user" ]] && break
        echo -e "${RED}Username cannot be empty.${NC}"
    done

    while true; do
        read -r -s -p "NetAccess Password: " input_pass < "$tty"
        echo
        [[ -n "$input_pass" ]] && break
        echo -e "${RED}Password cannot be empty.${NC}"
    done

    printf '%s\n%s\n' "$input_user" "$input_pass" > "$CREDENTIAL_FILE"
    chmod 600 "$CREDENTIAL_FILE"
    echo -e "${GREEN}==>${NC} ${BOLD}Credentials saved securely.${NC}"
    echo
}

# ==============================================================================
# Network Detection (NetworkManager / nmcli)
# ==============================================================================

get_network_info() {
    SSID=""
    IP=""
    IFACE=""

    if command -v nmcli >/dev/null 2>&1; then
        IFACE=$(nmcli -t -f DEVICE,TYPE,STATE device 2>/dev/null | awk -F: '$2=="wifi" && $3=="connected" {print $1; exit}')
        if [[ -n "$IFACE" ]]; then
            # Query active connection without triggering an active Wi-Fi channel scan
            SSID=$(nmcli -t -f GENERAL.CONNECTION dev show "$IFACE" 2>/dev/null | cut -d: -f2- | xargs)
            IP=$(ip -4 -o addr show dev "$IFACE" scope global 2>/dev/null | awk '{split($4, a, "/"); print a[1]; exit}')
        fi
    fi

    # Fallback IP detection via routing table if needed
    if [[ -z "$IP" ]]; then
        IP=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src") {print $(i+1); exit}}')
    fi
}

# ==============================================================================
# Portal Authentication
# ==============================================================================

perform_login() {
    local current_ip="$1"
    log "Sending login request for IP: $current_ip..."

    # Native curl URL-encoding: password is fed via stdin (password@-) to protect from ps aux
    # Fresh login does not load old cookies, but saves newly issued session cookie to COOKIE_FILE
    local response
    response=$(
        printf '%s' "$PASSWORD" | curl \
            --silent \
            --show-error \
            --connect-timeout 10 \
            --max-time 30 \
            --request POST \
            --cookie-jar "$COOKIE_FILE" \
            --data-urlencode "username=$USERNAME" \
            --data-urlencode "password@-" \
            "${PORTAL}/?src=${current_ip}&url=" 2>&1
    )
    local curl_exit=$?

    if [[ "$curl_exit" -ne 0 ]]; then
        log "curl failed (code $curl_exit): $response"
        return 1
    fi

    if echo "$response" | grep -qi -E "Access Granted!|internet access granted"; then
        log "LOGIN SUCCESSFUL: Internet access active."
        [[ -f "$COOKIE_FILE" ]] && chmod 600 "$COOKIE_FILE" 2>/dev/null || true
        return 0
    elif echo "$response" | grep -qi "Already Connected"; then
        if is_internet_alive; then
            log "ALREADY CONNECTED: Internet access active."
            [[ -f "$COOKIE_FILE" ]] && chmod 600 "$COOKIE_FILE" 2>/dev/null || true
            return 0
        fi

        log "Stale session detected (portal says Already Connected but internet blocked). Clearing session..."
        curl -s --connect-timeout 5 --max-time 10 "${PORTAL}/portal/relogin" >/dev/null 2>&1 || true

        # Re-send login after clearing stale session
        response=$(
            printf '%s' "$PASSWORD" | curl \
                --silent \
                --show-error \
                --connect-timeout 10 \
                --max-time 30 \
                --request POST \
                --cookie-jar "$COOKIE_FILE" \
                --data-urlencode "username=$USERNAME" \
                --data-urlencode "password@-" \
                "${PORTAL}/?src=${current_ip}&url=" 2>&1
        )
        if echo "$response" | grep -qi -E "Access Granted!|internet access granted|Already Connected"; then
            log "LOGIN SUCCESSFUL: Internet access active."
            [[ -f "$COOKIE_FILE" ]] && chmod 600 "$COOKIE_FILE" 2>/dev/null || true
            return 0
        fi
        return 1
    else
        local title
        title=$(echo "$response" | sed -n 's:.*<title>\(.*\)</title>.*:\1:p' | head -n1 | sed 's/<[^>]*>//g' | xargs)
        log "Login response: ${title:-unrecognized response}"
        return 1
    fi
}

perform_logout() {
    echo -e "${CYAN}==>${NC} Stopping auto-login service..."
    systemctl --user stop "$SERVICE_NAME" 2>/dev/null || true
    pkill -f "ismwifi daemon" 2>/dev/null || true

    if [[ -f "$COOKIE_FILE" ]]; then
        echo -e "${CYAN}==>${NC} Sending logout request using saved session cookie..."
        curl --silent \
            --connect-timeout 5 \
            --max-time 10 \
            --cookie "$COOKIE_FILE" \
            "${PORTAL}/portal/logout" >/dev/null 2>&1 || true
        rm -f "$COOKIE_FILE"
    else
        echo -e "${YELLOW}==>${NC} No saved session cookie found. Sending generic logout request..."
        curl --silent \
            --connect-timeout 5 \
            --max-time 10 \
            "${PORTAL}/portal/logout" >/dev/null 2>&1 || true
    fi

    echo -e "${GREEN}==>${NC} ${BOLD}Logged out successfully.${NC}"
    echo "  • Campus portal session terminated."
    echo "  • Background auto-login stopped."
    echo "  • Run 'ismwifi' when you want to connect and log in again."
    echo
}

# ==============================================================================
# Service Setup & Management
# ==============================================================================

ensure_installed() {
    mkdir -p "$(dirname "$INSTALL_BIN")" "$SYSTEMD_DIR"

    # Self-install to ~/.local/bin/ismwifi if run from elsewhere
    local current_script target_script
    current_script=$(realpath "$0" 2>/dev/null || echo "$0")
    target_script=$(realpath "$INSTALL_BIN" 2>/dev/null || echo "$INSTALL_BIN")

    if [[ "$current_script" != "$target_script" ]]; then
        cp -f "$0" "$INSTALL_BIN"
        chmod 755 "$INSTALL_BIN"
    fi

    # Ensure ~/.local/bin is in PATH for future shells
    case ":${PATH}:" in
        *":$HOME/.local/bin:"*) ;;
        *)
            local shell_rc="$HOME/.bashrc"
            [[ -n "${ZSH_VERSION:-}" || "${SHELL:-}" =~ "zsh" ]] && shell_rc="$HOME/.zshrc"
            if ! grep -q '\.local/bin' "$shell_rc" 2>/dev/null; then
                echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$shell_rc"
            fi
            export PATH="$HOME/.local/bin:$PATH"
            ;;
    esac

    cat > "$SYSTEMD_FILE" <<EOF
[Unit]
Description=IIT (ISM) Campus Wi-Fi Auto Login
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/ismwifi daemon
Restart=always
RestartSec=15
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=default.target
EOF
}

start_service() {
    check_dependencies

    if ! has_credentials; then
        prompt_credentials
    fi

    ensure_installed

    systemctl --user daemon-reload
    systemctl --user enable "$SERVICE_NAME" >/dev/null 2>&1
    systemctl --user restart "$SERVICE_NAME" 2>/dev/null || systemctl --user start "$SERVICE_NAME"

    echo -e "${BOLD}${GREEN}============================================================${NC}"
    echo -e "${BOLD}     IIT (ISM) Wi-Fi Auto-Login is ACTIVE & ENABLED         ${NC}"
    echo -e "${BOLD}${GREEN}============================================================${NC}"
    echo "  • Background Service : Running (auto-starts on boot / login)"
    echo "  • Wi-Fi Monitoring   : Checks every ${CHECK_SECONDS}s for '$EXPECTED_SSID'"
    echo "  • Auto-Refresh       : Re-authenticates every 60 minutes"
    echo "  • Health Recovery    : Auto-reconnects on sleep resume or session drop"
    echo
    echo -e "${BOLD}Commands:${NC}"
    echo "  ismwifi            - Start and enable service"
    echo "  ismwifi kill       - Stop and disable service"
    echo "  ismwifi restart    - Restart the service"
    echo "  ismwifi status     - Show current connection status"
    echo "  ismwifi logs       - View live service logs"
    echo "  ismwifi logout     - Log out from campus portal"
    echo "  ismwifi config     - Update username or password"
    echo "  ismwifi uninstall  - Remove service and binary"
    echo "  ismwifi --help     - Show all options"
    echo

    get_network_info
    if [[ "$SSID" == "$EXPECTED_SSID" ]]; then
        echo -e "${GREEN}Connected to $EXPECTED_SSID (IP: ${IP:-unknown})${NC}"
    else
        echo -e "${YELLOW}Current Wi-Fi: ${SSID:-Disconnected}${NC}"
        echo "Auto-login will trigger automatically when connected to '$EXPECTED_SSID'."
    fi
    echo
}

kill_service() {
    echo -e "${CYAN}==>${NC} Stopping IIT (ISM) Wi-Fi auto-login service..."
    systemctl --user stop "$SERVICE_NAME" 2>/dev/null || true
    systemctl --user disable "$SERVICE_NAME" 2>/dev/null || true
    pkill -f "ismwifi daemon" 2>/dev/null || true

    echo -e "${GREEN}==>${NC} ${BOLD}Service stopped and disabled.${NC}"
    echo "  • Background process terminated."
    echo "  • Will NOT auto-start on next boot."
    echo "  • Run 'ismwifi' anytime to start again."
    echo
}

show_status() {
    echo -e "${BOLD}${CYAN}============================================================${NC}"
    echo -e "${BOLD}           IIT (ISM) Wi-Fi Auto-Login Status                ${NC}"
    echo -e "${BOLD}${CYAN}============================================================${NC}"

    if systemctl --user is-active --quiet "$SERVICE_NAME" 2>/dev/null; then
        echo -e "Service Status     : ${GREEN}Active (running)${NC}"
    else
        echo -e "Service Status     : ${RED}Inactive (stopped)${NC}"
    fi

    local service_enabled="disabled"
    if systemctl --user is-enabled --quiet "$SERVICE_NAME" 2>/dev/null; then
        service_enabled="enabled"
    fi
    echo -e "Auto-start on boot : ${BOLD}$service_enabled${NC}"

    get_network_info
    echo -e "Interface          : ${BOLD}${IFACE:-None}${NC}"
    if [[ "$SSID" == "$EXPECTED_SSID" ]]; then
        echo -e "SSID               : ${GREEN}${SSID}${NC} (Campus Wi-Fi)"
    elif [[ -n "$SSID" ]]; then
        echo -e "SSID               : ${YELLOW}${SSID}${NC} (Not campus Wi-Fi)"
    else
        echo -e "SSID               : ${RED}Disconnected${NC}"
    fi
    echo -e "Local IPv4         : ${BOLD}${IP:-Not assigned}${NC}"
    if [[ -n "$IP" ]]; then
        if is_internet_alive; then
            echo -e "Internet Status    : ${GREEN}Online & Working${NC}"
        else
            echo -e "Internet Status    : ${YELLOW}Blocked / Captive Portal Required${NC}"
        fi
    else
        echo -e "Internet Status    : ${RED}Offline${NC}"
    fi
    echo
}

uninstall_tool() {
    echo -e "${YELLOW}Uninstalling ismwifi...${NC}"
    perform_logout
    systemctl --user disable "$SERVICE_NAME" 2>/dev/null || true

    rm -f "$SYSTEMD_FILE"
    systemctl --user daemon-reload 2>/dev/null || true
    rm -f "$INSTALL_BIN" "$COOKIE_FILE"

    read -r -p "Delete saved credentials (~/.config/ismwifi)? [y/N]: " del_creds
    if [[ "$del_creds" =~ ^[Yy]$ ]]; then
        rm -rf "$CONFIG_DIR"
        echo "Credentials deleted."
    fi
    echo -e "${GREEN}Uninstalled successfully.${NC}"
}

show_help() {
    cat <<EOF
IIT (ISM) Campus Wi-Fi Auto-Login (ismwifi)

Usage:
  ismwifi               Start and enable background auto-login
  ismwifi kill          Stop and disable background auto-login (alias: stop)
  ismwifi restart       Restart the background auto-login service
  ismwifi status        Show service status and Wi-Fi connection
  ismwifi logs          View live service logs (alias: log)
  ismwifi logout        Log out from captive portal and stop auto-login
  ismwifi config        Update saved credentials (alias: setup)
  ismwifi uninstall     Remove service, binary, and saved cookie
  ismwifi --help, -h    Show this help message

Options:
  ismwifi daemon        Background loop (used internally by systemd)

Files:
  Credentials : ~/.config/ismwifi/credentials (chmod 600)
  Cookie      : ~/.config/ismwifi/cookie (chmod 600)
  Service     : ~/.config/systemd/user/ismwifi.service
  Binary      : ~/.local/bin/ismwifi
EOF
}

# ==============================================================================
# Daemon Loop (Executed by systemd in background)
# ==============================================================================

daemon_mode() {
    check_dependencies
    load_credentials

    log "IIT (ISM) Wi-Fi auto-login daemon started."
    log "Monitoring SSID: $EXPECTED_SSID | Refresh: ${REFRESH_SECONDS}s"

    local is_authenticated=0
    local auth_ip=""
    local next_attempt=0
    local last_tick
    last_tick=$(date +%s)
    local next_health_check=0

    trap 'log "Daemon stopping..."; exit 0' SIGTERM SIGINT

    while true; do
        local now
        now=$(date +%s)

        # Detect system suspend / resume from sleep (clock jumped ahead)
        if (( (now - last_tick) > (CHECK_SECONDS + 15) )); then
            log "System resume from sleep detected (suspended for $((now - last_tick))s)."
            is_authenticated=0
            auth_ip=""
            next_attempt=0
            next_health_check=0
        fi
        last_tick=$now

        get_network_info

        # Not on campus Wi-Fi -> stay idle
        if [[ "${SSID:-}" != "$EXPECTED_SSID" ]] || [[ -z "${IP:-}" ]]; then
            if [[ "$is_authenticated" -eq 1 ]]; then
                log "Disconnected from $EXPECTED_SSID."
            fi
            is_authenticated=0
            auth_ip=""
            next_attempt=0
            next_health_check=0
            sleep "$CHECK_SECONDS"
            continue
        fi

        # Periodic health check: if authenticated, verify gateway hasn't silently killed session
        if [[ "$is_authenticated" -eq 1 && $now -ge $next_health_check ]]; then
            next_health_check=$((now + PROBE_SECONDS))
            if ! is_internet_alive; then
                log "Internet connectivity lost (session dropped by gateway). Re-authenticating..."
                is_authenticated=0
                next_attempt=0
            fi
        fi

        # Trigger login if:
        # 1. Unauthenticated and retry cooldown passed
        # 2. IP changed while connected
        # 3. 60-minute session refresh is due
        if [[ "$is_authenticated" -eq 0 && $now -ge $next_attempt ]] || \
           [[ -n "$auth_ip" && "$IP" != "$auth_ip" && $now -ge $next_attempt ]] || \
           [[ "$is_authenticated" -eq 1 && $now -ge $next_attempt ]]; then

            if [[ "$is_authenticated" -eq 1 ]]; then
                log "60-minute session refresh due."
            elif [[ -n "$auth_ip" && "$IP" != "$auth_ip" ]]; then
                log "IP change detected: $auth_ip -> $IP"
            else
                log "Connected to $EXPECTED_SSID (Interface: $IFACE, IP: $IP)."
            fi

            if perform_login "$IP"; then
                is_authenticated=1
                auth_ip="$IP"
                next_attempt=$((now + REFRESH_SECONDS))
                next_health_check=$((now + PROBE_SECONDS))
            else
                is_authenticated=0
                next_attempt=$((now + RETRY_SECONDS))
                log "Login failed. Retrying in ${RETRY_SECONDS}s."
            fi
        fi

        sleep "$CHECK_SECONDS"
    done
}

# ==============================================================================
# Entry Point
# ==============================================================================

COMMAND="${1:-start}"

case "$COMMAND" in
    daemon)
        daemon_mode
        ;;
    start)
        start_service
        ;;
    kill|stop)
        kill_service
        ;;
    restart)
        kill_service
        start_service
        ;;
    status)
        show_status
        ;;
    logs|log)
        echo -e "${CYAN}==>${NC} Streaming logs (Ctrl+C to stop)..."
        exec journalctl --user -u "$SERVICE_NAME" -f
        ;;
    logout)
        perform_logout
        ;;
    config|setup)
        prompt_credentials
        ;;
    uninstall)
        uninstall_tool
        ;;
    -h|--help|help)
        show_help
        ;;
    *)
        echo -e "${RED}Unknown command: $COMMAND${NC}"
        echo "Run 'ismwifi --help' for available commands."
        exit 1
        ;;
esac
